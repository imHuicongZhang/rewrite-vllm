# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
#   cp .env.example .env && $EDITOR .env
#
# This file is the template and keeps its blanks forever; the checker skips it.
# Your .env is checked, and must have no blanks left.

# Read access to the single input dataset, wytro/Know-Your-Sources-7B.
# NOTE: that repo is GATED (manual review). The account behind this token must have been
# GRANTED access by Wytro, or every download 403s. preflight check 7 verifies this.
# Create at https://huggingface.co/settings/tokens
HF_TOKEN=<<<TIANJIAN: your HuggingFace token, needs READ access to the input datasets>>>

# OPTIONAL, and unused on a normal run. Upload is DISABLED by default
# (configs/data.yaml upload.enabled: false) because delivery of the finished data is
# arranged separately -- the run ends with parquet on disk under out_root/shuffled/.
# Leave this blank unless you have deliberately set upload.enabled: true, in which case
# it needs WRITE scope on the output org. If one token covers both, use the same value.
HF_TOKEN_WRITE=

# Faster Hub transfers. Leave as-is.
HF_HUB_ENABLE_HF_TRANSFER=1
